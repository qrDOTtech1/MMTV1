# GHOST bot -- variables requises. NE JAMAIS mettre de vraies valeurs ici :
# ce fichier est commite dans git. Les vraies valeurs se configurent en
# variables de service dans le dashboard Railway (Settings -> Variables),
# jamais dans le repo.
# Colle ta clé privée MetaMask ici (sans 0x devant, on gère)
PRIVATE_KEY=

# RPC Base (gratuit, pas besoin de changer)
RPC_URL=
CHAIN_ID=

# Mode: paper (simulé) ou live (argent réel)
MODE=
FORCE_BOOST=
POLY_AUTOSTART=
POLY_LIVE=
POLY_FUNDER_ADDRESS=

# Copilote IA (Steven 29/07) : cle Groq (gratuite sur console.groq.com) ->
# pilote le bot en autonome (mode/budget/plancher/MM/DN). Vide =
GROQ_API_KEY=

OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_CLOUD_API_KEY=

# ── Securite API (obligatoire pour un deploiement public) ──────────
# Genere avec: openssl rand -hex 32
# Sans cette valeur, l'API refuse TOUT (fail-closed), voir server.py.
# La MEME valeur doit etre mise dans DetailDesk (variable MMTRADE_API_TOKEN)
# pour que la page /admin/mmtrade puisse parler au bot.
MMTRADE_API_TOKEN=